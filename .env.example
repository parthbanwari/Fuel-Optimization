# ── Django core ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-string

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── OpenRouteService ──────────────────────────────────────────────────────────
# Sign up FREE at https://openrouteservice.org/dev/#/signup
# Dashboard → Tokens → Request a token (free tier: 2,000 req/day)
ORS_API_KEY=your-ors-api-key-here

# ── Redis  (used for route caching) ──────────────────────────────────────────
# Local: redis://localhost:6379/0
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Database (leave blank to use SQLite for local dev) ───────────────────────
# Example: postgres://user:password@localhost:5432/fuel_route
DATABASE_URL=

# ── Tunable constants (safe to leave at defaults) ────────────────────────────
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
ROUTE_CORRIDOR_MILES=30
ROUTE_CACHE_TTL_SECONDS=86400
GEOCODE_CACHE_TTL_SECONDS=2592000
